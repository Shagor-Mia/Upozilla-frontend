NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Homna Upazila

# This deployment's tenant slug (Section 13 Phase 5). Sent server-side only as
# the X-Tenant-Slug header so anonymous requests resolve to the right tenant.
# Blank is safe today (single-tenant deployment) - the backend falls back to
# the oldest active tenant. Required once a second tenant exists.
TENANT_SLUG=

# Section 16.1 — GTM houses GA4 + Meta Pixel inside its container, no separate script tags
NEXT_PUBLIC_GTM_ID=

# Section 2 — Mapbox GL JS. Without this, MapView falls back to a coordinates line.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Section 16.2 — Facebook Login. Without this the "Continue with Facebook" button is hidden.
NEXT_PUBLIC_FACEBOOK_APP_ID=

# Same pattern — Google Login. Without this the "Continue with Google" button is hidden.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Section 10 — WebSocket origin for live messaging. Defaults to the API URL with ws:// scheme.
NEXT_PUBLIC_WS_BASE_URL=

# NOTE: GTM ID, Mapbox token, Facebook App ID, Google Client ID and Turnstile site key can
# also be set from the admin CMS (/admin/settings). A value saved there overrides the env vars above.
